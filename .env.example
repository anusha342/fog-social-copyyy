# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Google OAuth — https://console.cloud.google.com
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sync server
NEXT_PUBLIC_SYNC_SERVER_URL=

# LogRocket session recording — defaults to the "qkapm0/fog-social" project if unset.
# Set NEXT_PUBLIC_LOGROCKET_ENABLED=false to disable recording (e.g. local dev).
NEXT_PUBLIC_LOGROCKET_APP_ID=
NEXT_PUBLIC_LOGROCKET_ENABLED=
